{"id":"S001","text":"포장이 깔끔했어요.","label":"긍정"}
{"id":"S002","text":"상자 안에서 악취가 났어요.","label":"부정"}
{"id":"S003","text":"상담원이 친절했어요.","label":"긍정"}
{"id":"S004","text":"상담원이 무례했어요.","label":"부정"}
{"id":"S005","text":"오늘은 기쁘네요.","label":"긍정"}
{"id":"S006","text":"오늘은 기분이 우울해요.","label":"부정"}
{"id":"S007","text":"가방이 튼튼해서 든든해요.","label":"긍정"}
{"id":"S008","text":"가방이 엉성하고 불량이에요.","label":"부정"}
{"id":"S009","text":"실내가 쾌적하고 시원해요.","label":"긍정"}
{"id":"S010","text":"매장이 불결하고 시끄러워요.","label":"부정"}
{"id":"S011","text":"설명이 정확하고 유용해요.","label":"긍정"}
{"id":"S012","text":"설명이 복잡하고 부정확해요.","label":"부정"}
{"id":"S013","text":"할인혜택 덕분에 저렴해요.","label":"긍정"}
{"id":"S014","text":"가격인상 때문에 부담이 커요.","label":"부정"}
{"id":"S015","text":"당일발송 덕분에 제시간에 받았어요.","label":"긍정"}
{"id":"S016","text":"배송지연으로 일정이 엉켰어요.","label":"부정"}
{"id":"S017","text":"꼼꼼포장이 인상적이에요.","label":"긍정"}
{"id":"S018","text":"포장파손 때문에 내용물이 젖었어요.","label":"부정"}
{"id":"S019","text":"문제해결 과정이 간편해요.","label":"긍정"}
{"id":"S020","text":"환불지연이 반복됐어요.","label":"부정"}
{"id":"S021","text":"사은품까지 챙겨줘서 감사해요.","label":"긍정"}
{"id":"S022","text":"구성품누락으로 사용이 불가능해요.","label":"부정"}
{"id":"S023","text":"무료반품 절차가 합리적이에요.","label":"긍정"}
{"id":"S024","text":"환불거절 안내가 황당해요.","label":"부정"}
{"id":"S025","text":"신속응대 덕분에 안심했어요.","label":"긍정"}
{"id":"S026","text":"연락두절이라 막막해요.","label":"부정"}
{"id":"S027","text":"커피가 고소하고 향긋해요.","label":"긍정"}
{"id":"S028","text":"커피가 텁텁하고 밋밋해요.","label":"부정"}
{"id":"S029","text":"과일이 신선하고 상큼해요.","label":"긍정"}
{"id":"S030","text":"빵이 퍽퍽하고 눅눅해요.","label":"부정"}
{"id":"S031","text":"색감이 화사하고 선명해요.","label":"긍정"}
{"id":"S032","text":"색감이 촌스럽고 초라해요.","label":"부정"}
{"id":"S033","text":"책의 구성이 알차고 유익해요.","label":"긍정"}
{"id":"S034","text":"설명이 지루하고 따분해요.","label":"부정"}
{"id":"S035","text":"첫 화면의 디자인이 참신해요.","label":"긍정"}
{"id":"S036","text":"버튼 배치가 번거롭고 불편해요.","label":"부정"}
{"id":"S037","text":"비행기 좌석이 편안해요.","label":"긍정"}
{"id":"S038","text":"비행기 좌석이 딱딱하고 불편해요.","label":"부정"}
{"id":"S039","text":"선물이 마음에 들어서 행복해요.","label":"긍정"}
{"id":"S040","text":"결제오류가 계속되어 짜증 나요.","label":"부정"}
{"id":"S041","text":"주문에 만족해요.","label":"긍정"}
{"id":"S042","text":"이 주문은 정말 최악이에요.","label":"부정"}
{"id":"S043","text":"가이드가 도움이 돼서 고마워요.","label":"긍정"}
{"id":"S044","text":"서비스가 무책임해서 분노가 생겨요.","label":"부정"}
{"id":"S045","text":"매장이 깨끗해요.","label":"긍정"}
{"id":"S046","text":"진열대가 더럽고 지저분해요.","label":"부정"}
{"id":"S047","text":"배송이 늦지 않아요.","label":"긍정"}
{"id":"S048","text":"배송이 빠르고 좋지 않아요.","label":"부정"}
{"id":"S049","text":"사용 방법이 어렵지 않아요.","label":"긍정"}
{"id":"S050","text":"이 주문은 안 좋아요.","label":"부정"}
{"id":"S051","text":"방이 전혀 불편하지 않아요.","label":"긍정"}
{"id":"S052","text":"제품 상태가 좋지 않았어요.","label":"부정"}
{"id":"S053","text":"생각보다 비싸지 않네요.","label":"긍정"}
{"id":"S054","text":"이 식당은 정말 맛있지 않았어요.","label":"부정"}
{"id":"S055","text":"좌석은 나쁘지 않았어요.","label":"긍정"}
{"id":"S056","text":"상담원이 친절하지 않네요.","label":"부정"}
{"id":"S057","text":"안 어렵네요.","label":"긍정"}
{"id":"S058","text":"제품이 전혀 튼튼하지 않아요.","label":"부정"}
{"id":"S059","text":"반품 과정이 복잡하지 않아요.","label":"긍정"}
{"id":"S060","text":"진행 절차가 편리하지 않아요.","label":"부정"}
{"id":"S061","text":"상품이 별로 좋지 않지는 않아요.","label":"긍정"}
{"id":"S062","text":"안내 문구가 정확하지 못해요.","label":"부정"}
{"id":"S063","text":"방이 좁지만 완전 편안해요.","label":"긍정"}
{"id":"S064","text":"공간이 넉넉하지만 완전 지저분해요.","label":"부정"}
{"id":"S065","text":"대기가 길고 불편했지만 정말 만족해요.","label":"긍정"}
{"id":"S066","text":"할인은 좋지만 배송이 너무 느려요.","label":"부정"}
{"id":"S067","text":"조금 아쉽지만 서비스가 좋아요.","label":"긍정"}
{"id":"S068","text":"조금 고소하지만 전체적으로 느끼해요.","label":"부정"}
{"id":"S069","text":"가격은 비싸지만 아주 튼튼해요.","label":"긍정"}
{"id":"S070","text":"깔끔하지만 너무 불편해요.","label":"부정"}
{"id":"S071","text":"포장은 엉성하지만 굉장히 훌륭해요.","label":"긍정"}
{"id":"S072","text":"예쁘지만 너무 질겨요.","label":"부정"}
{"id":"S073","text":"정말 추천해요.","label":"긍정"}
{"id":"S074","text":"매우 나빠요.","label":"부정"}
{"id":"S075","text":"아주 맛있어요.","label":"긍정"}
{"id":"S076","text":"너무 재미없어요.","label":"부정"}
{"id":"S077","text":"정품인증 덕분에 안심해요.","label":"긍정"}
{"id":"S078","text":"가짜 제품이라 실망했어요.","label":"부정"}
{"id":"S079","text":"교환완료 안내가 정확해요.","label":"긍정"}
{"id":"S080","text":"초기불량 때문에 다시 보내야 해요.","label":"부정"}
{"id":"S081","text":"전시 분위기가 고요하고 포근해요.","label":"긍정"}
{"id":"S082","text":"음악이 시끄럽고 귀가 아파요.","label":"부정"}
{"id":"S083","text":"원두 향이 매력 있어요.","label":"긍정"}
{"id":"S084","text":"냄새가 역겹고 불쾌해요.","label":"부정"}
{"id":"S085","text":"덕분에 마음이 놓였어요.","label":"긍정","note":"관용구 ‘마음이 놓이다’에 감성 어간이 없다."}
{"id":"S086","text":"와, 최고네요. 주문한 물건은 하나도 안 왔어요.","label":"부정","note":"‘최고’를 칭찬으로 처리하고 뒤 문장에서 빈정거림의 단서를 찾지 못한다."}
{"id":"S087","text":"이 정도면 두 번 더 사겠어요.","label":"긍정","note":"재구매 의도를 여러 어절에 걸쳐 추론해야 한다."}
{"id":"S088","text":"고객을 하루 종일 기다리게 하다니 정말 친절하네요.","label":"부정","note":"반어에 쓰인 ‘친절’을 문자 그대로 점수화한다."}
{"id":"S089","text":"상자가 손바닥만 한데 필요한 건 다 들어가요.","label":"긍정","note":"수납이 충분하다는 긍정이 감성어 없이 드러난다."}
{"id":"S090","text":"배송은 좋았지만 깨진 유리는 쓸 수가 없네요.","label":"부정","note":"파손 상태 ‘깨진’과 사용 불가 구문을 인식하지 못해 배송 점수만 남는다."}
{"id":"S091","text":"포장부터 설명서까지 흠잡을 데가 없어요.","label":"긍정","note":"‘흠잡을 데가 없다’는 여러 어절을 묶어야 하는 긍정 표현이다."}
{"id":"S092","text":"밤마다 전원이 꺼져서 세 번씩 일어났어요.","label":"부정","note":"오작동을 직접 표현하는 사전 어휘 없이 상황으로 설명한다."}
{"id":"S093","text":"별 기대 없이 주문했는데 제 용도에 딱 맞네요.","label":"긍정","note":"‘기대 없이’를 약한 기대의 긍정으로 읽고 ‘딱 맞다’의 문맥을 파악하지 못한다."}
{"id":"S094","text":"사흘째 배송 조회 화면만 새로고침 중입니다.","label":"부정","note":"반복 조회를 배송 불만으로 해석하려면 상황 추론이 필요하다."}
{"id":"S095","text":"비 오는 날에도 안에 물 한 방울 안 들어왔어요.","label":"긍정","note":"방수 성능을 ‘물이 들어오지 않았다’는 사실에서 추론해야 한다."}
{"id":"S096","text":"고객센터에 세 번 전화했는데 아직 연결이 안 돼요.","label":"부정","note":"부정하는 대상이 연결 상태이며 사전 감성어가 없다."}
{"id":"S097","text":"친구에게도 하나 보내주려고요.","label":"긍정","note":"다른 사람에게 구매해 줄 의도에서 만족을 간접적으로 나타낸다."}
{"id":"S098","text":"받자마자 반품 버튼부터 눌렀어요.","label":"부정","note":"반품 선택을 불만의 단서로 보는 규칙이 없다."}
{"id":"S099","text":"다 쓰면 이 회사 제품으로 다시 채울게요.","label":"긍정","note":"다시 구입하겠다는 의도를 문장 단위에서 추론해야 한다."}
{"id":"S100","text":"설명서에는 쉬워 보였는데 조립에 세 시간이 걸렸어요.","label":"부정","note":"‘쉬워’를 긍정으로 점수화하지만 긴 작업 시간에서 생기는 불만은 포착하지 못한다."}
{"id":"S101","text":"새벽에 켜도 옆방에서 못 들었대요.","label":"긍정","note":"소음이 적다는 장점을 부정문과 사용 상황에서 추론해야 한다."}
{"id":"S102","text":"새 상품이라더니 상자 안에 사용 흔적이 있어요.","label":"부정","note":"‘사용 흔적’이 새 상품이라는 기대를 어겼다는 판단이 필요하다."}
{"id":"S103","text":"여행 내내 발에 물집이 한 번도 안 생겼어요.","label":"긍정","note":"불편이 발생하지 않았다는 사실을 긍정으로 바꾸는 규칙이 없다."}
{"id":"S104","text":"할인혜택은 받았지만 상자를 열어 보니 다른 모델이 왔어요.","label":"부정","note":"오배송을 여러 어절로 서술해 할인 혜택의 긍정 점수만 잡힌다."}
